DROPSHARE_PORT=3000
TRUST_PROXY=true
APP_URL=https://your-domain.com

NEXT_PUBLIC_DROPSHARE_URL=https://your-domain.com
NEXT_PUBLIC_AUTH_URL=https://your-domain.com

PUBLIC_DROPSHARE_URL=https://your-domain.com
PUBLIC_AUTH_URL=https://your-domain.com

# Passkeys / WebAuthn - set to your bare domain (no https://, no port).
WEBAUTHN_RP_ID=your-domain.com
WEBAUTHN_RP_NAME=DropShare
WEBAUTHN_ORIGINS=https://your-domain.com

# Local SQLite by default. Stored under the data/ volume.
DATABASE_URL=file:../data/dropshare.db?connection_limit=1

# Object storage (optional). Leave R2_ENABLED=false to store files on local disk.
R2_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=dropshare
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
