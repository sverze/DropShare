{
  "name": "dropshare-backend",
  "version": "2.0.0",
  "scripts": {
    "build": "nest build",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "prod": "prisma migrate deploy && node dist/src/main",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --end-of-line=auto --write 'src/**/*.ts'",
    "test:system": "prisma migrate reset -f && nest start & wait-on http://localhost:8080/api/configs && newman run ./test/newman-system-tests.json"
  },
  "prisma": {
    "seed": "ts-node prisma/seed/config.seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/lib-storage": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@keyv/redis": "^4.4.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.17",
    "@nestjs/core": "^11.0.17",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.17",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/server": "^13.2.2",
    "@smithy/node-http-handler": "^4.4.7",
    "@types/jmespath": "^0.15.2",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "axios": "^1.7.7",
    "body-parser": "^2.2.0",
    "cache-manager": "^6.4.2",
    "cacheable": "^1.9.0",
    "clamscan": "^2.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "content-disposition": "^0.5.4",
    "cookie-parser": "^1.4.7",
    "jmespath": "^0.16.0",
    "ldapts": "^8.1.8",
    "mime-types": "^3.0.1",
    "moment": "^2.30.1",
    "music-metadata": "^11.10.3",
    "nanoid": "^3.3.7",
    "nodemailer": "^8.0.8",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode-svg": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.1",
