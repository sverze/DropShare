# Adds SQLite replication on top of the application image.
#
# Built as an overlay rather than a change to the project Dockerfile, so the
# upstream build and the local docker-compose workflow stay exactly as they
# are. Build the base image first, then this.
#
#   docker build -t dropshare:base .
#   docker build -t dropshare:deploy -f infra/deploy/Dockerfile.litestream \
#     --build-arg BASE_IMAGE=dropshare:base infra/deploy

ARG BASE_IMAGE=dropshare:base
FROM ${BASE_IMAGE}

# litestream replicates the write-ahead log to S3; sqlite is needed to switch
# the database into WAL mode, which litestream requires; aws-cli carries the
# avatar directory, which the application only ever writes to local disk.
ARG LITESTREAM_VERSION=0.3.13
ARG TARGETARCH=amd64

USER root

RUN apk add --no-cache sqlite aws-cli \
    && wget -q -O /tmp/litestream.tar.gz \
      "https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM_VERSION}/litestream-v${LITESTREAM_VERSION}-linux-${TARGETARCH}.tar.gz" \
    && tar -xzf /tmp/litestream.tar.gz -C /usr/local/bin litestream \
    && rm /tmp/litestream.tar.gz \
    && chmod +x /usr/local/bin/litestream

COPY litestream.yml /etc/litestream.yml
COPY replicated-entrypoint.sh /opt/app/replicated-entrypoint.sh
RUN chmod +x /opt/app/replicated-entrypoint.sh

ENTRYPOINT ["sh", "/opt/app/replicated-entrypoint.sh"]
