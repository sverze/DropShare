# DropShare configuration. Copy to `.env`, set APP_URL, then `docker compose up -d`.

DROPSHARE_IMAGE=ghcr.io/xcided/dropshare:latest

HOST_PORT=3000
# 0.0.0.0 publishes the app on every interface, so it stays reachable on
# HOST_PORT even behind a reverse proxy. Use 127.0.0.1 if the proxy is the
# only thing that should reach it.
BIND_ADDR=0.0.0.0

APP_URL=https://your-domain.com

# Both default to APP_URL. Set only if reached on a different address.
# PUBLIC_DROPSHARE_URL=
# PUBLIC_AUTH_URL=

TRUST_PROXY=true

# RP_ID is the bare domain, no scheme or port. Changing it later invalidates
# every existing passkey.
WEBAUTHN_RP_ID=your-domain.com
WEBAUTHN_RP_NAME=DropShare
WEBAUTHN_ORIGINS=https://your-domain.com

DATABASE_URL=file:../data/dropshare.db?connection_limit=1
DB_BACKUP_KEEP=10

# Local disk by default. The R2_ prefix is historical; any S3-compatible
# provider works (Amazon S3, Cloudflare R2, Backblaze B2, MinIO).
#
# Storage turns on if EITHER this or Admin -> Config is complete, so clear the
# s3.* admin settings too if you want it genuinely off.
R2_ENABLED=false
# R2_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=
# R2_REGION=
# Path-style addressing. Default true; set false for Amazon S3.
# R2_FORCE_PATH_STYLE=true

# On AWS, omit the two key lines entirely to use an instance profile or ECS
# task role via the SDK credential chain.

# Needs a ClamAV container, plus Virus scanning enabled in Admin -> Config.
VIRUS_SCAN_AUTO_START=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# true stops all background work: expiry, pruning, cleanup, previews.
DISABLE_SCHEDULED_JOBS=false

PUID=1000
PGID=1000
